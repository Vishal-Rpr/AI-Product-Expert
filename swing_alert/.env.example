# Reuses the same SMTP secrets as daily_digest.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
RECIPIENT_EMAIL=your-email@gmail.com

# Optional: Gemini for the 3-4 sentence narrative summary
GEMINI_API_KEY=your-gemini-api-key-here

# --- Exit tracker (Block B) ---
# Google Sheet ID where you log open swing positions.
# Get it from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
POSITIONS_SHEET_ID=

# --- Predictions Log (Week 1 learning loop) ---
# Google Sheet ID where every morning's picks are auto-appended for outcome tracking.
# Separate from the positions sheet — this one is machine-written only.
PREDICTIONS_SHEET_ID=

# Full JSON of a Google service account key that has Editor access to the sheet.
# Create at https://console.cloud.google.com/iam-admin/serviceaccounts, download JSON,
# then paste the entire JSON as a single-line string (or use GitHub secret directly).
GOOGLE_SA_JSON=

# --- Position sizing (2% risk per trade) ---
# Your swing-trading capital in INR (used only for suggested quantity calc; nothing is auto-traded)
CAPITAL_INR=500000
# Fraction of capital risked per trade (0.02 = 2%)
RISK_PER_TRADE_PCT=0.02
